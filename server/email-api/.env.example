# ===== EL NORAN email API — environment variables =====
# Set these in Vercel: Project → Settings → Environment Variables.
# NEVER commit real values.

# Email provider: "resend" (default) or "brevo"
EMAIL_PROVIDER=resend

# Resend API key (https://resend.com/api-keys) — used when EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Brevo API key (https://app.brevo.com/settings/keys/api) — used when EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx

# Sender. Must be an address on a domain verified with your provider (e.g. elnoranegypt.com).
MAIL_FROM=EL NORAN Website <website@elnoranegypt.com>

# Recipients — every inquiry is sent to ALL of these in a single email (comma-separated).
MAIL_TO=shahd.rafat@elnoranegypt.com,Mahmoud.ElGazar@elnoranegypt.com

# Websites allowed to call this API (comma-separated, no trailing slash).
ALLOWED_ORIGINS=https://shahdgamil.github.io,http://localhost:5173,http://localhost:4173

# ----- OPTIONAL: WhatsApp Business Cloud API (notify both numbers automatically) -----
# Leave empty to disable.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=201156002078,201005857878
WHATSAPP_TEMPLATE=new_website_inquiry
WHATSAPP_TEMPLATE_LANG=en
